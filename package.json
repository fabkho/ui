{
  "name": "@fabkho/ui",
  "version": "0.1.0",
  "description": "Bookretreats' and BetterReads' shared UI base: a Nuxt layer of components, composables, utils and a Tailwind v4 stylesheet, themed only through CSS variables.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabkho/ui.git"
  },
  "packageManager": "pnpm@10.34.7",
  "exports": {
    ".": "./nuxt.config.ts",
    "./pure/*": {
      "types": "./dist/pure/*.d.ts",
      "default": "./dist/pure/*.js"
    },
    "./*": "./*"
  },
  "main": "./nuxt.config.ts",
  "files": [
    "app.config.ts",
    "assets",
    "components",
    "composables",
    "nuxt.config.ts",
    "plugins",
    "router.options.ts",
    "testing",
    "utils",
    "dist",
    "!components/**/*.stories.ts"
  ],
  "scripts": {
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:storybook:night": "VITE_STORY_THEME=night vitest run --project storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "build:pure": "tsc -p tsconfig.pure.json",
    "prepare": "tsc -p tsconfig.pure.json",
    "pretest": "pnpm build:pure"
  },
  "dependencies": {
    "thumbhash": "0.1.1"
  },
  "peerDependencies": {
    "nuxt": "^4.5.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@storybook-vue/nuxt": "10.0.3",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "nuxt": "4.6.2",
    "playwright": "1.64.1",
    "storybook": "10.6.2",
    "storybook-addon-pseudo-states": "10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  }
}
