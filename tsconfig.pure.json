{
  // The framework-free utils, built to plain ESM + .d.ts for Node (`@fabkho/ui/pure/*`).
  // Only files with no Nuxt or app imports belong here (see scripts/build-pure.sh and README).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "rootDir": "utils/chat",
    "outDir": "dist/pure",
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "files": ["utils/chat/voice.ts", "utils/chat/timeline.ts", "utils/chat/reply.ts"]
}
